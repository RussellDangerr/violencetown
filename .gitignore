# =============================================================
# Asset protection — DO NOT REMOVE LINES WITHOUT REVIEW
# This repo is public. Anything that lands in git history is
# forensically recoverable forever, even after deletion.
# =============================================================

# --- Licensed/paid asset folders (defense layer 1: explicit) ---
assets/
assetszipped/

# Exception: game/assets/ is reserved for procedurally-generated assets we
# author ourselves (bitmap fonts, UI panels, wheel frames — all output of
# scripts in tools/). These are first-party and safe to commit. Anything
# under game/assets-placeholder/ for licensed Kenney packs stays excluded
# because it's not the same folder.
!game/assets/
!game/assets/**

# --- Archive & executable files (defense layer 2: extensions) ---
# Catches any new asset zip dropped anywhere, plus installers/launchers.
# The repo ships pure HTML/CSS/JS; no legitimate need to commit these.
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.exe
*.msi
*.dmg

# --- Source-art files (defense layer 3: art extensions) ---
# Asset packs often include editable source files alongside PNGs.
# These are higher-value than exported sprites and must not leak.
*.psd
*.aseprite
*.ase
*.xcf
*.kra
*.clip

# --- OS / editor housekeeping ---
.DS_Store
Thumbs.db
desktop.ini
